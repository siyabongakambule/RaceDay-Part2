@model RaceDay.Web.ViewModels.EventResultsViewModel

@{
    ViewData["Title"] = "Race Results";
}

<div class="container mt-4 mb-5">

    <h1 class="fw-bold">Race Results</h1>
    <p class="text-muted">Manage results for @Model.EventName</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    <h3 class="mt-4">Record Participant Results</h3>

    @if (Model.Enrolments == null || !Model.Enrolments.Any())
    {
        <div class="alert alert-info">
            There are no enrolments for this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolment Status</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                        <th>Action</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var enrolment in Model.Enrolments)
                    {
                        <tr>
                            <td>@enrolment.ParticipantName</td>
                            <td>@enrolment.CategoryName</td>
                            <td>@enrolment.Status</td>

                            <td colspan="3">
                                <form asp-controller="Organiser"
                                      asp-action="RecordResult"
                                      method="post"
                                      class="d-flex gap-2 flex-wrap">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="eventId"
                                           value="@Model.EventID" />

                                    <input type="hidden"
                                           name="enrollmentId"
                                           value="@enrolment.EnrollmentID" />

                                    <input type="time"
                                           name="finishTime"
                                           step="1"
                                           class="form-control"
                                           required />

                                    <input type="number"
                                           name="position"
                                           min="1"
                                           placeholder="Position"
                                           class="form-control" />

                                    <button type="submit"
                                            class="btn btn-success">
                                        Save Result
                                    </button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <h3 class="mt-5">Recorded Results</h3>

    @if (Model.Results == null || !Model.Results.Any())
    {
        <div class="alert alert-info">
            No race results have been recorded yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-striped table-bordered">
                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Finish Time</th>
                        <th>Position</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var result in Model.Results)
                    {
                        <tr>
                            <td>@result.ParticipantName</td>
                            <td>@result.CategoryName</td>
                            <td>@result.FinishTime</td>
                            <td>@(result.Position?.ToString() ?? "-")</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-controller="Organiser"
       asp-action="Events"
       class="btn btn-outline-secondary mt-3">
        Back to Events
    </a>

</div>
