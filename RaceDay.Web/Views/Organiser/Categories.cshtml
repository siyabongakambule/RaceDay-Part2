@model List<RaceDay.Web.ViewModels.CategoryViewModel>

@{
    ViewData["Title"] = "Event Categories";
}

<div class="container mt-4 mb-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fw-bold">Event Categories</h1>
            <p class="text-muted">@ViewBag.EventName</p>
        </div>

        <a asp-action="CreateCategory"
           asp-route-eventId="@ViewBag.EventID"
           class="btn btn-primary">
            + Add Category
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">@TempData["SuccessMessage"]</div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">@TempData["ErrorMessage"]</div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No categories have been added to this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-dark">
                    <tr>
                        <th>Category</th>
                        <th>Distance (KM)</th>
                        <th>Entry Fee</th>
                        <th>Maximum Participants</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var category in Model)
                    {
                        <tr>
                            <td>@category.CategoryName</td>
                            <td>@category.DistanceKm</td>
                            <td>R @category.EntryFee.ToString("N2")</td>
                            <td>@category.MaxParticipants</td>
                            <td>
                                <div class="d-flex gap-2">
                                    <a asp-action="EditCategory"
                                       asp-route-eventId="@ViewBag.EventID"
                                       asp-route-categoryId="@category.CategoryID"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <form asp-action="DeleteCategory"
                                          asp-route-eventId="@ViewBag.EventID"
                                          asp-route-categoryId="@category.CategoryID"
                                          method="post"
                                          onsubmit="return confirm('Delete this category?');">

                                        <button type="submit"
                                                class="btn btn-sm btn-danger">
                                            Delete
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    <a asp-action="Events" class="btn btn-outline-secondary">
        Back to Events
    </a>

</div>
