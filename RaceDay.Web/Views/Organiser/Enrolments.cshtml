@model List<RaceDay.Web.ViewModels.EnrolmentViewModel>

@{
    ViewData["Title"] = "Manage Enrolments";
}

<div class="container mt-4 mb-5">

    <h1 class="fw-bold">Manage Enrolments</h1>
    <p class="text-muted">@ViewBag.EventName</p>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success">
            @TempData["SuccessMessage"]
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger">
            @TempData["ErrorMessage"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No participants have enrolled in this event yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-hover align-middle">

                <thead class="table-dark">
                    <tr>
                        <th>Participant</th>
                        <th>Category</th>
                        <th>Enrolment Date</th>
                        <th>Status</th>
                        <th>Update Status</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.ParticipantName</td>
                            <td>@item.CategoryName</td>
                            <td>@item.EnrolmentDate.ToString("dd MMM yyyy")</td>
                            <td>@item.Status</td>

                            <td>
                                <form asp-action="UpdateEnrolmentStatus"
                                      method="post">

                                    @Html.AntiForgeryToken()

                                    <input type="hidden"
                                           name="id"
                                           value="@item.EnrollmentID" />

                                    <input type="hidden"
                                           name="eventId"
                                           value="@ViewBag.EventID" />

                                    <select name="status"
                                            class="form-select mb-2">

                                        <option value="Pending">Pending</option>
                                        <option value="Confirmed">Confirmed</option>
                                        <option value="Cancelled">Cancelled</option>

                                    </select>

                                    <button type="submit"
                                            class="btn btn-primary btn-sm">
                                        Update
                                    </button>

                                </form>
                            </td>
                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

    <a asp-action="Events"
       class="btn btn-outline-secondary">
        Back to Events
    </a>

</div>