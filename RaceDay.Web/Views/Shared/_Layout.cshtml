<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
<title>@ViewData["Title"] - RaceDay</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
      rel="stylesheet" />
<link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg navbar-dark raceday-navbar">
        <div class="container">
            <a class="navbar-brand fw-bold"
               asp-controller="Home"
               asp-action="Index">
                <span class="brand-icon">R</span> RaceDay
            </a>
            <button class="navbar-toggler" type="button"
                    data-bs-toggle="collapse"
                    data-bs-target="#mainNavbar"
                    aria-controls="mainNavbar"
                    aria-expanded="false"
                    aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="mainNavbar">
                <ul class="navbar-nav me-auto">
                    <li class="nav-item">
                        <a class="nav-link"
                           asp-controller="Home"
                           asp-action="Index">Home</a>
                    </li>
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        @if (User.IsInRole("Organiser"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Organiser"
                                   asp-action="Dashboard">
                                    Organiser Dashboard
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Participant"))
                        {
                            <li class="nav-item">
                                <a class="nav-link"
                                   asp-controller="Participant"
                                   asp-action="Dashboard">
                                    Participant Dashboard
                                </a>
                            </li>
                        }
                    }
                </ul>
                <div class="d-flex align-items-center gap-3">
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <span class="navbar-text text-white">
                            Hello, @User.Identity.Name
                        </span>
                        <form asp-controller="Account"
                              asp-action="Logout"
                              method="post">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-outline-light">
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-controller="Account"
                           asp-action="Login"
                           class="btn btn-outline-light">
                            Login
                        </a>
                        <a asp-controller="Account"
                           asp-action="Register"
                           class="btn btn-raceday">
                            Register
                        </a>
                    }
                </div>
            </div>
        </div>
    </nav>
</header>
<main>
    @RenderBody()
</main>
<footer class="raceday-footer">
    <div class="container text-center">
        <p class="mb-1">RaceDay - Every Race Has a Story.</p>
        <small>&copy; @DateTime.Now.Year RaceDay. All rights reserved.</small>
    </div>
</footer>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>