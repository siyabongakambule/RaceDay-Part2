@model List<RaceDay.Web.ViewModels.ResultViewModel>

@{
    ViewData["Title"] = "My Results";
}

<div class="container mt-5">

    <h1>My Race Results</h1>

    <p class="text-muted">
        View your race history and finishing positions.
    </p>

    <hr />

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            You do not have any race results yet.
        </div>
    }
    else
    {
        <div class="table-responsive">

            <table class="table table-bordered table-striped">

                <thead class="table-dark">
                    <tr>
                        <th>Event</th>
                        <th>Category</th>
                        <th>Finishing Time</th>
                        <th>Position</th>
                        <th>Date Captured</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.EventName</td>
                            <td>@item.CategoryName</td>
                            <td>@item.FinishTime</td>
                            <td>
                                @(item.Position.HasValue
                                    ? item.Position.ToString()
                                    : "Not assigned")
                            </td>
                            <td>@item.CapturedDate.ToString("dd MMMM yyyy")</td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>
    }

    <a asp-controller="Participant"
       asp-action="Dashboard"
       class="btn btn-secondary mt-3">
        Back to Dashboard
    </a>

</div>